<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-title" content="Timetable" />
    <link rel="manifest" href="manifest.json" />
    <link rel="apple-touch-icon" sizes="180x180" href="icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="icons/icon-512.png" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta name="apple-touch-startup-image" content="icons/icon-512.png" />
    <title>Semester 1 — Timetable</title>
    <style>
        :root {
            --red: #e63946;
            --blue: #457b9d;
            --dark-blue: #1d3557;
            --orange: #f4a261;
            --yellow: #e9c46a;
            --paper: #f5f5f0;
            --black: #000;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--paper);
            font-family: "Futura", "Arial", sans-serif;
            padding: 40px 20px;
            color: var(--black);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        h1 {
            font-size: 48px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 40px;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 40px;
        }

        .page-header h1 {
            margin-bottom: 0;
        }

        .edit-toggle {
            background: transparent;
            border: 1px solid var(--black);
            color: var(--black);
            font-family: inherit;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 6px 12px;
            cursor: pointer;
            transition: background 0.2s ease, color 0.2s ease;
            -webkit-tap-highlight-color: transparent;
        }

        .edit-toggle[aria-pressed="true"] {
            background: var(--black);
            color: #fff;
        }

        .edit-time,
        .edit-activity {
            width: 100%;
            border: 1px solid #ddd;
            padding: 6px 8px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 600;
            color: #222;
            background: #fff;
        }

        .edit-activity {
            min-height: 28px;
        }

        body.edit-mode .event {
            background: #fffdf5;
        }

        .day {
            margin-bottom: 30px;
            background: #fff;
            border: 3px solid var(--black);
            overflow: hidden;
        }

        .day-header {
            background: var(--black);
            color: #fff;
            padding: 15px 20px;
            font-size: 24px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
        }

        .day-header::before {
            content: "";
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            width: 40px;
            height: 40px;
            border-radius: 50%;
        }

        .monday .day-header::before { background: var(--red); }
        .tuesday .day-header::before { background: var(--blue); }
        .wednesday .day-header::before { background: var(--orange); }
        .thursday .day-header::before { background: var(--dark-blue); }
        .friday .day-header::before { background: var(--yellow); }

        .event {
            padding: 15px 20px;
            border-bottom: 2px solid var(--black);
            display: grid;
            grid-template-columns: 120px 1fr;
            gap: 20px;
            align-items: center;
            position: relative;
            background: #fff;
        }

        .event:last-child {
            border-bottom: none;
        }

        .event.empty {
            background: var(--paper);
        }

        .time {
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .activity {
            font-size: 16px;
            font-weight: 600;
            color: #222;
            min-height: 20px;
        }

        .event::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 8px;
            background: transparent;
        }

        .phy-255::before { background: var(--red); }
        .cos-210::before { background: var(--blue); }
        .cos-212::before { background: var(--dark-blue); }
        .wtw-211::before { background: var(--orange); }
        .wtw-218::before { background: var(--yellow); }

        .activity a {
            color: inherit;
            text-decoration: none;
        }

        .activity a:hover {
            text-decoration: underline;
        }

        /* Navigation */
        .site-nav {
            background: var(--black);
            padding: 0 20px;
            display: flex;
            align-items: center;
            gap: 0;
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 3px solid var(--red);
        }

        .site-nav a {
            color: #999;
            text-decoration: none;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 16px 20px;
            transition: color 0.2s ease, background 0.2s ease;
            font-family: "Futura", "Arial", sans-serif;
        }

        .site-nav a:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
        }

        .site-nav a.active {
            color: #fff;
            border-bottom: 3px solid var(--red);
            margin-bottom: -3px;
        }

        .nav-spacer {
            flex: 1;
        }

        .nav-label {
            color: #555;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding-right: 10px;
            font-family: "Futura", "Arial", sans-serif;
        }

        @media (max-width: 768px) {
            body {
                padding: 0 0 80px 0;
                padding-bottom: calc(80px + env(safe-area-inset-bottom));
            }

            .container {
                max-width: 100%;
                padding: 15px 12px;
            }

            h1 {
                font-size: 28px;
                margin-bottom: 15px;
            }

            .page-header {
                margin-bottom: 15px;
            }

            .edit-toggle {
                font-size: 8px;
                padding: 6px 10px;
            }

            /* Hide top nav on mobile */
            .site-nav {
                display: none;
            }

            /* Bottom tab bar */
            .bottom-nav {
                display: flex;
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                background: var(--black);
                border-top: 3px solid var(--red);
                z-index: 200;
                padding-bottom: env(safe-area-inset-bottom);
            }

            .bottom-nav a {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 4px;
                padding: 10px 5px;
                color: #666;
                text-decoration: none;
                font-family: "Futura", "Arial", sans-serif;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 1px;
                text-transform: uppercase;
                transition: color 0.2s ease;
                -webkit-tap-highlight-color: transparent;
            }

            .bottom-nav a.active {
                color: #fff;
            }

            .bottom-nav .nav-icon {
                font-size: 20px;
                line-height: 1;
            }

            /* "What's Next" banner */
            .whats-next {
                display: block;
                background: var(--black);
                color: #fff;
                padding: 16px;
                margin-bottom: 15px;
                border-left: 5px solid var(--red);
            }

            .whats-next-label {
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 2px;
                text-transform: uppercase;
                color: var(--red);
                margin-bottom: 6px;
            }

            .whats-next-class {
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 3px;
            }

            .whats-next-time {
                font-size: 12px;
                color: #999;
                font-weight: 600;
            }

            .whats-next.done {
                border-left-color: #666;
            }

            .whats-next.done .whats-next-label {
                color: #666;
            }

            /* Day cards */
            .day {
                margin-bottom: 12px;
                border-width: 2px;
            }

            .day-header {
                font-size: 16px;
                padding: 12px 15px;
                position: sticky;
                top: 0;
                z-index: 10;
            }

            .day-header::before {
                width: 28px;
                height: 28px;
            }

            /* Highlight today */
            .day.today {
                border-color: var(--red);
                border-width: 2px;
            }

            .day.today .day-header {
                background: var(--red);
            }

            .day.today .day-header::before {
                background: #fff !important;
            }

            /* Dim other days */
            .day.not-today {
                opacity: 0.55;
                transition: opacity 0.3s ease;
            }

            .day.not-today:active,
            .day.not-today:focus-within {
                opacity: 1;
            }

            /* Events */
            .event {
                grid-template-columns: 90px 1fr;
                gap: 10px;
                padding: 12px 15px;
                border-bottom-width: 1px;
                min-height: 44px;
            }

            .event::before {
                width: 5px;
            }

            .time {
                font-size: 13px;
            }

            .activity {
                font-size: 13px;
            }

            .activity a {
                display: block;
                padding: 2px 0;
            }

            /* Hide empty slots toggle */
            .event.empty.hidden-empty {
                display: none;
            }

            /* Toggle button */
            .toggle-empty {
                display: inline-block;
                background: none;
                border: 2px solid var(--black);
                color: var(--black);
                font-family: "Futura", "Arial", sans-serif;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 1px;
                text-transform: uppercase;
                padding: 8px 14px;
                margin-bottom: 15px;
                cursor: pointer;
                -webkit-tap-highlight-color: transparent;
            }

            .toggle-empty.active {
                background: var(--black);
                color: #fff;
            }
        }

        /* Desktop: hide mobile-only elements */
        @media (min-width: 769px) {
            .bottom-nav { display: none; }
            .whats-next { display: none; }
            .toggle-empty { display: none; }
        }

        .nav-label {
            display: none;
        }
    </style>
</head>
<body>
            <div id="orbitdesk-loader" role="dialog" aria-label="Loading OrbitDesk" style="position:fixed;z-index:9999;top:0;left:0;width:100vw;height:100vh;background:#fff;display:flex;align-items:center;justify-content:center;transition:opacity 0.6s;">
                <div style="display:grid;grid-template-columns:1fr 1fr;align-items:center;justify-items:center;width:100vw;height:100vh;">
                    <div style="display:flex;flex-direction:column;align-items:flex-end;justify-content:center;padding-right:2vw;">
                        <span style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:64px;font-weight:900;color:#e63946;line-height:1;letter-spacing:-2px;text-transform:uppercase;">Orbit</span>
                        <span style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:64px;font-weight:900;color:#000;line-height:1;letter-spacing:-2px;text-transform:uppercase;">Desk</span>
                    </div>
                    <div style="display:flex;align-items:center;justify-content:center;">
                        <svg id="swiss-logo" width="160" height="160" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="OrbitDesk Swiss Loader Logo" role="img">
                            <rect x="0" y="0" width="160" height="160" fill="#fff"/>
                            <g id="swiss-bars-group">
                                <rect id="swiss-bar" x="30" y="75" width="100" height="10" rx="5" fill="#e63946"/>
                                <rect id="swiss-bar-v" x="75" y="30" width="10" height="100" rx="5" fill="#e63946"/>
                            </g>
                            <circle id="swiss-dot" cx="80" cy="80" r="28" fill="#fff" stroke="#000" stroke-width="4" filter="url(#shadow)"/>
                            <defs>
                                <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
                                    <feDropShadow dx="0" dy="6" stdDeviation="4" flood-color="#000" flood-opacity="0.18"/>
                                </filter>
                            </defs>
                        </svg>
                    </div>
                </div>
            </div>
    <!-- Firebase SDK (compat for simplicity in a plain HTML file) -->
